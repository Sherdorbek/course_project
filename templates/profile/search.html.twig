{% extends 'base.html.twig' %}

{% block title %}Search{% endblock %}

{% block body %}
  <div class="container">
    <a href="{{path('user_profile',{id:user.id})}}"><i class="fa-solid fa-chevron-left"></i> back</a>
    <div
      class="card py-3 px-4 my-4"
      data-controller="search-attribute"
      data-search-attribute-url-value="{{ path('user_add_attribute', {id: user.id}) }}"
    >
      <form action="{{ path('user_add_attribute', {id: user.id}) }}" method="post">
        <h5 class="card-title mb-3">Search attributes</h5>
        <div
          class="d-flex w-100 gap-2"
        >
          <div class="col">
            <input data-action="input->search-attribute#search" class="form-control" type="text" name="q" placeholder="Search attribute"/>
          </div>
          <div class="col-auto d-none" data-search-attribute-target="add">
            <button
              class="btn btn-primary"
              type="submit"
            >Add</button>
          </div>
        </div>

        {% include 'profile/_search-result.html.twig' %}
      </form>
    </div>
  </div>
{% endblock %}
