{% extends 'base.html.twig' %}

{% block title %}Edit Position{% endblock %}

{% block body %}

  <div
    class="container border  rounded py-3 px-4 my-4"
    data-controller="search-attribute"
    data-search-attribute-url-value="{{ path('user_add_attribute') }}"
  >
    <form action="{{ path('user_add_attribute') }}" method="post">
      <h5 class="card-title mb-3">2.Search attributes</h5>
      <div
        class="d-flex w-100 gap-2"
      >
        <div class="col">
          <input data-action="input->search-attribute#search" class="form-control" type="text" name="q" placeholder="Search attribute"/>
        </div>
        <div class="col-auto d-none" data-search-attribute-target="add">
          <button
            class="btn btn-primary"
            type="submit"
          >Add</button>
        </div>
      </div>

      {% include 'profile/_search-result.html.twig' %}
    </form>
  </div>
{% endblock %}
