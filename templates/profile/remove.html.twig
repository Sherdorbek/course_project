{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}

  <div class="container my-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <a href="{{path('user_profile',{id:user.id})}}"><i class="fa-solid fa-chevron-left"></i> back</a>
      <h5 class="mb-0">Attributes</h5>
      <div class="d-flex gap-2">
        <button
          type="submit"
          form="delete-form"
          class="btn btn-outline-danger d-inline-flex align-items-center gap-2"
          id="btn-delete"
        >
          <i class="fa-solid fa-trash"></i>
          <span>Delete</span>
        </button>
      </div>
    </div>

    <form method="post" action="{{ path('user_remove_attribute',{id:user.id}) }}" id="delete-form" data-controller="checkbox">

      <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
          <thead class="">
            <tr>
              <th scope="col" style="width: 40px;">
                <input class="form-check-input" type="checkbox" id="selectAll" data-action="change->checkbox#toggle">
              </th>
              <th scope="col">Name</th>
              <th scope="col">Type</th>
            </tr>
          </thead>
          <tbody>
            {% for ua in user.userAttributes %}
              <tr>
                <td>
                  <input class="form-check-input" data-checkbox-target="checkbox" type="checkbox" name="selectedUserAttributes[]" value="{{ ua.id }}">
                </td>
                <td>{{ ua.attribute.name }}</td>
                <td>{{ ua.attribute.type.value }}</td>
              </tr>
            {% else %}
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>

  </div>
{% endblock %}
