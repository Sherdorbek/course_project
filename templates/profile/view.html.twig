{% extends 'base.html.twig' %}

{% block title %}Proifle{% endblock %}

{% block body %}

  <div class="container" data-controller="autosave" style="max-width:900px">
    <div class="p-2 border rounded bg-body-tertiary mb-3 d-flex justify-content-around" data-contoller="scroll" data-turbo="false">
      <a class="btn flex-fill" data-action="click->scroll#scrollTo" href="#profile-me"><i class="fa-solid fa-circle-user"></i> Me</a>
      <a class="btn flex-fill" data-action="click->scroll#scrollTo" href="#profile-attributes"><i class="fa-solid fa-circle-info"></i> Info</a>
      <a class="btn flex-fill" data-action="click->scroll#scrollTo" href="#profile-projects"><i class="fa-regular fa-folder-open"></i> Projects</a>
      <a class="btn flex-fill" data-action="click->scroll#scrollTo" href="#profile-cvs"><i class="fa-regular fa-file-lines"></i> CVs</a>                
    </div>
    <div>       

      <div class="card mb-4" id="profile-me">
        <div class="card-body">
          <div class="p-3 d-flex justify-content-between align-items-center">     
            <h4 class="card-title mb-0"><i class="fa-regular fa-circle-user"></i> Me </h4>
            <div class="text-secondary fs-5"><i class="fa-regular fa-envelope"></i> {{ user.email }}</div>
          </div>  
          <div class="p-3">
            {% for ua in user.userAttributes %}
              {% if not ua.attribute.isRemovable %}
                {% if ua.attribute.type.value == 'image' %}
                  <label>{{ ua.attribute.name }}</label>
                  <img
                    src="{{ ua.valImage }}"
                    alt=""
                    class="img-thumbnail mb-2"
                    style="max-width: 180px"
                  >
                {% else %}
                  {% include "parts/_view-attribute.html.twig" with {attribute: ua.attribute, userValue: ua.value} %}
                {% endif %}

              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="card" id="profile-attributes">
        <div class="card-body">
          <h4 class="card-title"><i class="fa-solid fa-circle-info"></i> Info</h4>
          <div class="p-3">
            {% for ua in user.userAttributes %}
              {% if ua.attribute.isRemovable %}
                {% if ua.attribute.type.value == 'image' %}
                  <label>{{ ua.attribute.name }}</label>
                  <img
                    src="{{ ua.valImage }}"
                    alt=""
                    class="img-thumbnail mb-2"
                    style="max-width: 180px"
                  >
                {% else %}
                  {% include "parts/_view-attribute.html.twig" with {attribute: ua.attribute, userValue: ua.value} %}
                {% endif %}

              {% endif %}
            {% endfor %}
          </div>
           
        </div>
      </div>
        

    
      
      <div class="card my-4" id="profile-projects">
        <div class="card-body">  
          <div class="d-flex justify-content-between align-items-center">     
            <h4 class="card-title mb-0"><i class="fa-regular fa-folder-open"></i>Projects</h4>
          </div>  
        </div>
      </div>

      <div class="card my-4" id="profile-cvs">
        <div class="card-body">  
          <div class="d-flex justify-content-between align-items-center">     
            <h4 class="card-title mb-0"><i class="fa-regular fa-file-lines"></i> Cvs</h4>
          </div>

          <div class="tabel-responsive mt-2">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Position</th>
                  <th scope="col">Likes</th>
                  <th scope="col">Updated At</th>
                </tr>
              </thead>
              <tbody>
                {% for cv in user.cvs %}
                  <tr>
                    <td><a href="{{ path('app_cv_show', {position: cv.position.id, id: cv.id}) }}">{{ cv.position.title }}</a></td>
                    <td>{{ cv.likes|length }}</td>
                    <td>{{ cv.updatedAt|date('Y-d-m') }}</td>
                  </tr>
                {% endfor %} 
              </tbody>
            </table>
                       
          </div>  
        </div>
      </div>
        
        
    </div>
{% endblock %}
