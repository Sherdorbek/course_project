<twig:Turbo:Frame id="attributes">
    {{ form_start(form, {
        action: path('user_profile',{id:user.id}),
        attr: {
            'data-autosave-target': 'form',
            novalidate: 'novalidate',
             'data-controller': 'file-upload',
        }
    }) }}

    <div class="card mb-4" id="profile-me">
        <div class="card-body">
            <div class="p-3 d-flex justify-content-between align-items-center">     
                <h4 class="card-title mb-0"><i class="fa-regular fa-circle-user"></i> Me </h4>
                <div class="text-secondary fs-5"><i class="fa-regular fa-envelope"></i> {{ user.email }}</div>
            </div>  
            <div class="p-3">
                {% for attributeField in form.userAttributes %}
                    {% if not attributeField.vars.data.attribute.isRemovable %}
                        {% if attributeField.vars.data.attribute.type.value == 'image' %}
                            <label>{{ attributeField.vars.data.attribute.name }}</label>
                            {{ form_widget(attributeField.imageFile,{ attr: {
                                'data-file-upload-target': 'input',
                            }}) }}
                            <img
                                src="{{ attributeField.vars.data.valImage }}"
                                alt=""
                                class="img-thumbnail mb-2"
                                style="max-width: 180px"
                            >
                        {% else %}
                            {{ form_row(attributeField) }}
                        {% endif %}

                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card" id="profile-attributes">
        <div class="card-body">
            <h4 class="card-title"><i class="fa-solid fa-circle-info"></i> Info</h4>
            <div class="p-3">
                {% for attributeField in form.userAttributes %}
                    {% if attributeField.vars.data.attribute.isRemovable %}
                        {% if attributeField.vars.data.attribute.type.value == 'image' %}
                            <label>{{ attributeField.vars.data.attribute.name }}</label>
                            {{ form_widget(attributeField.imageFile,{ attr: {
                                'data-file-upload-target': 'input',
                            }}) }}
                            <img
                                src="{{ attributeField.vars.data.valImage }}"
                                alt=""
                                class="img-thumbnail mb-2"
                                style="max-width: 180px"
                            >
                        {% else %}
                            {{ form_row(attributeField) }}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </div>
           
        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
</twig:Turbo:Frame>
