{% extends 'base.html.twig' %}

{% block title %}Position{% endblock %}

{% block body %}

    <div class=" container d-flex justify-content-between px-4 pt-3 ">
        <a class="btn btn-outline-secondary" href="{{ path('app_position') }}">Back to list</a>
        {% if is_granted('ROLE_RECRUITER') %}
            <div>
                <a class="btn btn-success px-3" href="{{ path('app_cv_index', {position: position.id}) }}"><i class="fa-regular fa-file-lines"></i> Cvs ( {{ position.cvs|length }} ) </a>
            </div>
        {% endif %}
        <div class="d-flex flex-col gap-2">
            {% if is_granted('ROLE_CANDIDATE') %}
                <a class="btn btn-primary" href="{{ path('app_cv_new', {position: position.id}) }}">Create CV</a>
            {% endif %}
            {% if is_granted('ROLE_RECRUITER') %}
                <form action="{{ path('app_position_dublicate', {'id': position.id}) }}" method="post">
                    <button class="btn btn-warning">Dublicate</button>
                </form>
                {{ include('position/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
    <div class="container mt-3 ">
        <div class="card p-4 mb-4">
            <h3>Position details</h3>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Title</th>
                        <td>{{ position.title }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ position.description }}</td>
                    </tr>
                    <tr>
                        <th>Number of projects</th>
                        <td>{{ position.projectNumber }}</td>
                    </tr>
                    <tr>
                        <th>UpdatedAt</th>
                        <td>{{ position.updatedAt ? position.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                    </tr>
                </tbody>
            </table>
            {% if is_granted('ROLE_RECRUITER') %}
                <div>
                    <a class="btn btn-primary" href="{{ path('app_position_edit', {'id': position.id}) }}">Edit</a>
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                        View access token
                    </button>

                </div>
                
                

                <!-- Modal -->
                <div data-controller="copy" class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="staticBackdropLabel">Access token for this Position</h1>
                                <button data-action="click->copy#reset" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" data-copy-target="text">
                                {{ position.accessToken }}
                            </div>
                            <div class="modal-footer">
                                <button data-action="click->copy#copy" data-copy-target="btn" type="button" class="btn btn-primary">
                                    <i class="fa-regular fa-clipboard"></i>
                                    <span data-copy-target="btnText">Copy</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            {% endif %}
        </div>
        <div class="card p-4 mt-4">
            <h3>Position Attributes</h3>
        
            <div class="table-responsive rounded border">
                <table class="table align-middle mb-0">
                    <thead class="">
                        <tr>
                       
                            <th scope="col">Name</th>
                            <th scope="col">Category</th>
                            <th scope="col">Type</th>
                        </tr>
                    </thead>
                    <tbody id="selectedParent">
                        {% if position.attributes is not empty %}                
                            {% for attribute in position.attributes %}
                                <tr>
                                    <td>{{ attribute.name }}</td>
                                    <td>{{ attribute.category.name }}</td>
                                    <td> <span class="badge bg-{{ attribute.type.getColor() }}">{{ attribute.type.value }}</span></td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No attributes added.</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No attributes added.</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            {% if is_granted('ROLE_RECRUITER') %}
                <div>
                    <a class="btn btn-primary mt-2" href="{{ path('app_position_edit_attributes', {id: position.id}) }}">Edit attributes</a>
                </div>
            {% endif %}
        </div>
    
    </div>

    

   
{% endblock %}
