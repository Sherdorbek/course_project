<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr>
            <th scope="col" style="width: 40px;">
                <input class="form-check-input" type="checkbox" id="selectAll">
            </th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Type</th>
        </tr>
    </thead>
    <tbody>
        {% for attribute in attributes %}
            <tr>
                <td>
                    <input class="form-check-input row-checkbox" type="checkbox" name="selectedPositions[]" value="{{ position.id }}">
                </td>
                <td>
                    <a href="{{ path('app_position_edit', {id: position.id}) }}" class="text-decoration-none fw-semibold">
                        {{ attribute.attribute.name }}
                    </a>
                </td>
                <td>{{ attribute.attribute.description|u.truncate(50, '...', false) }}</td>
                <td>{{ attribute.attribute.type.value }}</td>            
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
