<twig:Turbo:Frame id="search-result">
    <div class="table-responsive border rounded my-3" data-controller="checkbox">
        <table class="table table-hover align-middle mb-0">
            <thead class="">
                <tr>
                    <th scope="col" style="width: 40px;">
                        <input class="form-check-input" type="checkbox" data-action="change->checkbox#toggle change->search-attribute#toggleAdd">
                    </th>
                    <th scope="col">Name</th>
                    <th scope="col">Category</th>
                    <th scope="col">Type</th>
                </tr>
            </thead>
            <tbody>
                {% if searchAttributes is defined %}                
                    {% for searchAttribute in searchAttributes %}
                        <tr>
                            <td>
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    value="{{ searchAttribute.id }}"
                                    data-checkbox-target="checkbox"
                                    data-search-attribute-target="checkbox"
                                    data-search-attribute-name-param="{{ searchAttribute.name }}"
                                    data-search-attribute-category-param="{{ searchAttribute.category.name }}"
                                    data-search-attribute-type-param="{{ searchAttribute.type.name }}"
                                    data-action="change->search-attribute#toggleAdd"
                                >
                            </td>
                            <td>{{ searchAttribute.name }}</td>
                            <td>{{ searchAttribute.category.name }}</td>
                            <td>{{ searchAttribute.type.name }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
                    </tr>
                {% endif %}

            </tbody>
        </table>
    </div>
</twig:Turbo:Frame>
