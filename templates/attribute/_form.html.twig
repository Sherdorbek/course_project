{{ form_start(form,{'attr': {'novalidate':'novalidate'}})}}

<div class="row">
    <div class="col">{{ form_row(form.category)}}</div>
    <div class="col">{{ form_row(form.name)}}</div>
</div>

{{ form_row(form.description)}}

<div data-controller="options" data-options-index-value="{{ form.oneOfManies|length }}">

    {{ form_row(form.type, {
    attr: {
    'data-options-target': 'typeSelect',
    'data-action': 'change->options#typeChanged'
    }
    }) }}

    <div data-options-target="wrapper" style="{% if form.type.vars.value != 'one_of_many' %}display:none{% endif %}">

        <label class="form-label">Options</label>

        <div class="text-danger">
            {{ form_errors(form.oneOfManies) }}
        </div>

        <div data-options-target="list" data-form-name="{{ form.oneOfManies.vars.full_name }}">

            {% for option in form.oneOfManies %}
            <div class="mb-2">
                <div class="input-group">
                    {{ form_widget(option.value) }}
                    <button type="button" class="btn btn-outline-secondary" data-action="options#removeOption">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
                {{ form_errors(option.value) }}
            </div>
            {% endfor %}
            {% do form.oneOfManies.setRendered() %}
        </div>

        <button type="button" class="btn btn-outline-primary my-2" data-action="options#addOption">
            <i class="fa-solid fa-plus"></i> Add Option
        </button>
    </div>
</div>

<div class="mt-3 d-flex gap-2 justify-content-end">
    <a href="{{ path('app_attributes') }}" class="btn btn-secondary">Cancel</a>
    {{ form_widget(form.save) }}
</div>

{{form_end(form)}}