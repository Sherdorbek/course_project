{% extends 'base.html.twig' %}

{% block title %}Attribute List{% endblock %}

{% block body %}


<div class="container my-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Attribute List</h5>
    <div class="d-flex gap-2">
      <a href="{{ path('app_attribute_new') }}" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        <span>Add</span>
      </a>
      <button type="submit" form="delete-form" class="btn btn-outline-danger d-inline-flex align-items-center gap-2"
        id="btn-delete">
        <i class="fa-solid fa-trash"></i>
        <span>Delete</span>
      </button>
    </div>
  </div>

  <form method="post" action="{{ path('app_attribute_delete_all') }}" id="delete-form">

    <div class="table-responsive border rounded">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" style="width: 40px;">
              <input class="form-check-input" type="checkbox" id="selectAll">
            </th>
            <th scope="col">Name</th>
            <th scope="col">Category</th>
            <th scope="col">Description</th>
            <th scope="col">Type</th>
          </tr>
        </thead>
        <tbody>
          {% for attr in attrs %}
          <tr>
            <td>
              <input class="form-check-input row-checkbox" type="checkbox" name="selectedAttr[]" value="{{ attr.id }}">
            </td>
            <td>
              <a href="{{ path('app_attribute_edit', {id: attr.id}) }}" class="text-decoration-none fw-semibold">
                {{ attr.name }}
              </a>
            </td>
            <td>{{ attr.category.name}}</td>
            <td>{{ attr.description|u.truncate(50, '...', false) }}</td>
            <td>
              <span class="badge bg-{{attr.type.getColor()}}">{{ attr.type.value }}</span>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </form>

</div>

<script>
  document.getElementById('selectAll')?.addEventListener('change', function () {
    document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
  });
</script>
{% endblock %}