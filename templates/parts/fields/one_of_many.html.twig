<div class="mb-3">
  <label for="text" class="form-label">{{ attribute.name }}</label>
  <select class="form-select" name="attribute[{{ attribute.id }}]">
    <option value="" selected>Select</option>
    {% for option in attribute.oneOfManies %}
      <option
        value="{{ option.id }}"
        {% if value == option.id %}
        selected
        {% endif %}
      >{{ option.value }}</option>
    {% endfor %}
  </select>
</div>
