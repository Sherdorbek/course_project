{% extends 'base.html.twig' %}

{% block title %}Cvs{% endblock %}

{% block body %}

  <div class="container my-4">
    <form method="post" action="{{ path('app_position_delete_all') }}" id="delete-form">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Cvs</h5>
        <div class="d-flex gap-2">
          <button
            type="submit"
            form="delete-form"
            class="btn btn-outline-danger d-inline-flex align-items-center gap-2"
            id="btn-delete"
          >
            <i class="fa-solid fa-trash"></i>
            <span>Delete</span>
          </button>
        </div>
      </div>


      <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 40px;">
                <input class="form-check-input" type="checkbox" id="selectAll">
              </th>
              <th scope="col">Candidate</th>
              <th scope="col">Description</th>
              <th scope="col">Likes</th>
            </tr>
          </thead>
          <tbody>
            {% for cv in position.cvs %}
              <tr>
                <td>
                  <input class="form-check-input row-checkbox" type="checkbox" name="selectedPositions[]" value="{{ position.id }}">
                </td>
                <td>
                  <a href="{{ path('app_position_show', {id: position.id}) }}" class="text-decoration-none fw-semibold">
                    {{ cv.user.email }}
                  </a>
                </td>
                <td>{{ cv.likes }}</td>
                <td>{{ cv.likes }}</td>            
              </tr>
            {% else %}
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">No attributes found.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>

  </div>

  <script>
    document.getElementById("selectAll")?.addEventListener("change", function () {
      document
        .querySelectorAll(".row-checkbox")
        .forEach((cb) => (cb.checked = this.checked));
    });
  </script>
{% endblock %}
