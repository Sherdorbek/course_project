{% extends 'base.html.twig' %}

{% block title %}Cv index{% endblock %}

{% block body %}
  <div class="container my-3">
    <h3>CVs list</h3>
    <div class="table-responsive border rounded">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" style="width: 40px;">
              <input class="form-check-input" type="checkbox" id="selectAll">
            </th>
            <th scope="col">id</th>
            <th scope="col">Likes</th>
          </tr>
        </thead>
        <tbody>
          {% for cv in cvs %}
            <tr>
              <td>
                <input class="form-check-input row-checkbox" type="checkbox" name="selectedPositions[]" value="{{ cv.id }}">
              </td>
              <td>
                <a href="{{ path('app_position_show', {id: cv.id}) }}" class="text-decoration-none fw-semibold">
                  {{ cv.id }}
                </a>
              </td>
              <td>{{ cv.likes }}</td>            
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">No CVs found.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
   
  </div>
{% endblock %}
