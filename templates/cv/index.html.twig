{% extends 'base.html.twig' %}

{% block title %}Cvs{% endblock %}

{% block body %}

  <div class="container my-4" data-controller="checkbox">
    <form method="post" action="{{ path('app_cv_delete', {position: position.id}) }}" id="delete-form">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="{{ path('app_position_show', {id: position.id}) }}" class="btn btn-outline-secondary"><i class="fa-solid fa-chevron-left"></i> back</a>
        <h5 class="mb-0">Cvs</h5>
        <div class="d-flex gap-2">
          {% if is_granted('ROLE_ADMIN') %}
          
            <button
              type="submit"
              form="delete-form"
              class="btn btn-outline-danger d-inline-flex align-items-center gap-2"
              id="btn-delete"
            >
              <i class="fa-solid fa-trash"></i>
              <span>Delete</span>
            </button>
          {% endif %}
        </div>
      </div>


      <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
          <thead class="">
            <tr>
              {% if is_granted('ROLE_ADMIN') %}
                <th scope="col" style="width: 40px;">
                  <input class="form-check-input" type="checkbox" data-action="change->checkbox#toggle">
                </th>
              {% endif %}
              <th scope="col">Candidate</th>
              <th scope="col">State</th>
              <th scope="col">Likes</th>
              <th scope="col">Updated at</th>
            </tr>
          </thead>
          <tbody>
            {% for cv in position.cvs %}
              <tr>
                {% if is_granted('ROLE_ADMIN') %}
                  <td>
                    <input class="form-check-input" data-checkbox-target="checkbox" type="checkbox" name="selectedCVs[]" value="{{ cv.id }}">
                  </td>
                {% endif %}
                <td>
                  <a href="{{ path('app_cv_show', {position: position.id, id: cv.id}) }}" class="text-decoration-none fw-semibold">
                    {{ cv.user.userattributes[0].value|default('Not denifed')  ~ ' ' ~ cv.user.userattributes[1].value|default('') }}
                  </a>
                </td>
                <td>Published</td>
                <td>{{ cv.likes|length }}</td>            
                <td>21-02-2004</td>            
              </tr>
            {% else %}
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">No CVs found.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>

  </div>
{% endblock %}
