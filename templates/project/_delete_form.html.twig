<form class="mt-2" method="post" action="{{ path('app_project_delete', {'user':user.id,'id': project.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>
